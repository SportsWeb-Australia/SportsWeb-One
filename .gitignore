# macOS Finder metadata
.DS_Store

# Dependencies (package-lock.json stays tracked)
node_modules/

# Build output
dist/
supabase/.temp/
.vercel

# Local env overrides — never commit these, they hold project keys
.env
.env.local
.env.*.local

# Generated by scripts/build-ssr-bundle.mjs during `npm run build` (server render
# bundle + the captured dist/index.html shell). Underscore-prefixed so Vercel
# treats them as private helpers, not routable functions.
api/_ssr.mjs
api/_shell.mjs
